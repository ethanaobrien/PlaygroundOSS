diff --git a/src/common/wiiu/sys/single_threaded.h b/src/common/wiiu/sys/single_threaded.h
new file mode 100644
index 0000000000..7eb90011dd
--- /dev/null
+++ b/src/common/wiiu/sys/single_threaded.h
@@ -0,0 +1,15 @@
+#pragma once
+
+// ANGLE's Wii U frontend is confined to the ProcUI/main thread.  The engine
+// may have unrelated audio/network workers, but they never enter EGL/GLES.
+// Keep libstdc++ reference counts on their single-threaded path: the generic
+// PowerPC atomic dispatch used when pthread symbols are linked is not usable
+// by this CafeOS port.
+inline constexpr bool __libc_single_threaded = true;
+
+// Cemu 2.6 does not correctly execute PowerPC conditional-trap instructions.
+// GCC folds impossible overflow guards into those instructions when their
+// failure arm is __builtin_trap(). Preserve the guard and its fatal behavior,
+// but lower the failure arm to an ordinary abort call.
+extern "C" void playground_wiiu_trap_abort(void);
+#define __builtin_trap() playground_wiiu_trap_abort()
